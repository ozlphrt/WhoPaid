rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasMembership(tripId) {
      return signedIn() && exists(
        /databases/$(database)/documents/users/$(request.auth.uid)/tripMemberships/$(tripId)
      );
    }

    function isOwner(tripId) {
      return signedIn() && (
        exists(/databases/$(database)/documents/trips/$(tripId)) && 
        get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid
      );
    }

    function isTripMember(tripId) {
      return signedIn() && (
        hasMembership(tripId) ||
        isOwner(tripId) ||
        exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
      );
    }

    function validInviteFor(tripId) {
      let inviteId = request.resource.data.inviteToken;
      return inviteId is string
        && exists(/databases/$(database)/documents/tripInvites/$(inviteId))
        && get(/databases/$(database)/documents/tripInvites/$(inviteId)).data.tripId == tripId
        && get(/databases/$(database)/documents/tripInvites/$(inviteId)).data.revoked != true;
    }

    // User profile and memberships
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;

      match /tripMemberships/{tripId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.tripId == tripId
          && (
            request.resource.data.role == 'owner' ||
            validInviteFor(tripId) ||
            exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
          );
        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.tripId == resource.data.tripId;
        allow delete: if signedIn() && (
          request.auth.uid == userId ||
          isOwner(tripId)
        );
      }
    }

    // Public invite tokens (read-only for authenticated users to look up tripId)
    match /tripInvites/{inviteToken} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.tripId is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.createdBy == request.auth.uid || isOwner(resource.data.tripId));
      allow delete: if signedIn()
        && (resource.data.createdBy == request.auth.uid || isOwner(resource.data.tripId));
    }

    // Trips collection and subcollections
    match /trips/{tripId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isTripMember(tripId)
      );
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isTripMember(tripId)
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{memberId} {
        allow read, create, update, delete: if signedIn();
      }

      match /households/{householdId} {
        allow read, write: if signedIn();
      }

      match /expenses/{expenseId} {
        allow read, write: if signedIn();
      }

      match /settlements/{settlementId} {
        allow read, write: if signedIn();
      }

      match /activities/{activityId} {
        allow read, write: if signedIn();
      }
    }

    // Collection group query support for members
    match /{path=**}/members/{memberId} {
      allow read: if signedIn();
    }
  }
}
