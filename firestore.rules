rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function hasMembership(tripId) {
      return signedIn() && exists(
        /databases/$(database)/documents/users/$(request.auth.uid)/tripMemberships/$(tripId)
      );
    }

    function isOwner(tripId) {
      return signedIn() && (
        exists(/databases/$(database)/documents/trips/$(tripId)) && 
        tripData(tripId).ownerId == request.auth.uid
      );
    }

    function isTripMember(tripId) {
      return isOwner(tripId) || hasMembership(tripId);
    }

    function validInviteFor(tripId) {
      let inviteId = request.resource.data.inviteToken;
      return inviteId is string
        && exists(/databases/$(database)/documents/tripInvites/$(inviteId))
        && get(/databases/$(database)/documents/tripInvites/$(inviteId)).data.tripId == tripId
        && get(/databases/$(database)/documents/tripInvites/$(inviteId)).data.revoked != true;
    }

    function legacyMemberMatchesCaller(tripId, memberId) {
      let memberPath = /databases/$(database)/documents/trips/$(tripId)/members/$(memberId);
      return exists(memberPath)
        && (
          get(memberPath).data.authUid == request.auth.uid ||
          get(memberPath).data.userId == request.auth.uid ||
          (
            request.auth.token.email is string &&
            get(memberPath).data.email == request.auth.token.email
          )
        );
    }

    function validLegacyMemberProof(tripId) {
      return request.resource.data.memberId is string
        && legacyMemberMatchesCaller(tripId, request.resource.data.memberId);
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;

      match /tripMemberships/{tripId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.resource.data.userId == userId
          && request.resource.data.tripId == tripId
          && (
            (
              request.auth.uid == userId && (
                isOwner(tripId) ||
                validInviteFor(tripId) ||
                validLegacyMemberProof(tripId)
              )
            ) ||
            (
              isOwner(tripId) &&
              request.resource.data.userId == userId &&
              request.resource.data.role == 'member'
            )
          );
        allow update: if signedIn()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.tripId == resource.data.tripId
          && (
            request.auth.uid == userId ||
            (isOwner(tripId) && request.resource.data.role == 'member')
          );
        allow delete: if signedIn() && (
          request.auth.uid == userId ||
          isOwner(tripId)
        );
      }
    }

    match /tripInvites/{inviteToken} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.tripId is string
        && request.resource.data.createdBy == request.auth.uid
        && isOwner(request.resource.data.tripId);
      allow update: if signedIn()
        && isOwner(resource.data.tripId)
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if signedIn() && isOwner(resource.data.tripId);
    }

    match /trips/{tripId} {
      allow read: if isTripMember(tripId);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.inviteToken is string;
      allow update, delete: if isOwner(tripId);

      match /members/{memberId} {
        allow read, create, update, delete: if isTripMember(tripId);
      }

      match /households/{householdId} {
        allow read, write: if isTripMember(tripId);
      }

      match /expenses/{expenseId} {
        allow read, write: if isTripMember(tripId);
      }

      match /settlements/{settlementId} {
        allow read, write: if isTripMember(tripId);
      }

      match /activities/{activityId} {
        allow read, write: if isTripMember(tripId);
      }
    }

    // Migration-only discovery for older shared trips that predate the
    // per-user membership index. Collection-group queries must constrain one
    // of these identity fields to the signed-in user's own Firebase identity.
    match /{documentPath=**}/members/{memberId} {
      allow list: if signedIn() && (
        resource.data.authUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        (
          request.auth.token.email is string &&
          resource.data.email == request.auth.token.email
        )
      );
    }
  }
}
