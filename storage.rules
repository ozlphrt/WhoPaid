rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isTripMember(tripId) {
      let trip = firestore.get(/databases/(default)/documents/trips/$(tripId)).data;
      return request.auth != null && (
        trip.ownerId == request.auth.uid ||
        firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)/tripMemberships/$(tripId)
        )
      );
    }

    match /trips/{tripId}/receipts/{fileName} {
      allow read: if isTripMember(tripId);
      allow create: if isTripMember(tripId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
      allow delete: if isTripMember(tripId);
    }
  }
}
