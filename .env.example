# Supabase project settings. The anon key is intentionally safe for browser use
# when PostgreSQL Row Level Security remains enabled. Never use a service-role
# key in Vite or any other client-side environment variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
